function getKatalog() {
  try {
    var ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    var sheet = ss.getSheetByName("Produk");
    var data = sheet.getDataRange().getValues();
    
    var result = [];
    for (var i = 1; i < data.length; i++) {
      result.push({
        id: data[i][0], kategori: data[i][1], game: data[i][2],
        layanan: data[i][3], harga: data[i][4], tipeForm: data[i][5]
      });
    }
    return { success: true, data: result };
  } catch (err) { return { success: false, message: err.toString() }; }
}

function buatPesanan(orderData) {
  try {
    var ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    var sheet = ss.getSheetByName("Pesanan");
    
    var dateStr = Utilities.formatDate(new Date(), "Asia/Jakarta", "yyyyMMdd");
    var randomNum = Math.floor(Math.random() * 9000) + 1000;
    var invoice = "INV-" + dateStr + "-" + randomNum;
    var timestamp = Utilities.formatDate(new Date(), "Asia/Jakarta", "yyyy-MM-dd HH:mm:ss");
    
    var detailString = JSON.stringify(orderData.detail);
    var status = "Pending";
    
    var newRow = [
      invoice, timestamp, orderData.kategori, orderData.game,
      detailString, orderData.totalHarga, status, orderData.metodeBayar, "-"
    ];
    
    sheet.appendRow(newRow);
    return { success: true, invoice: invoice, message: "Pesanan berhasil dibuat!" };
  } catch (err) { return { success: false, message: "Gagal membuat pesanan: " + err.toString() }; }
}

function lacakPesanan(invoice) {
  try {
    var ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    var sheet = ss.getSheetByName("Pesanan");
    var data = sheet.getDataRange().getValues();
    
    for (var i = 1; i < data.length; i++) {
      if (data[i][0] === invoice) {
        return { 
          success: true, 
          data: { invoice: data[i][0], tanggal: data[i][1], layanan: data[i][2] + " - " + data[i][3], harga: data[i][5], status: data[i][6] } 
        };
      }
    }
    return { success: false, message: "Invoice tidak ditemukan." };
  } catch (err) { return { success: false, message: err.toString() }; }
}

function getSemuaPesanan() {
  try {
    var ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    var sheet = ss.getSheetByName("Pesanan");
    var data = sheet.getDataRange().getValues();
    
    var result = [];
    for (var i = data.length - 1; i >= 1; i--) { 
      result.push({
        invoice: data[i][0], tanggal: data[i][1], kategori: data[i][2],
        game: data[i][3], detail: JSON.parse(data[i][4] || "{}"), harga: data[i][5], status: data[i][6], metode: data[i][7]
      });
    }
    return { success: true, data: result };
  } catch (err) { return { success: false, message: err.toString() }; }
}

function updateStatusPesanan(invoice, statusBaru) {
  try {
    var ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    var sheet = ss.getSheetByName("Pesanan");
    var data = sheet.getDataRange().getValues();
    
    for (var i = 1; i < data.length; i++) {
      if (data[i][0] === invoice) {
        sheet.getRange(i + 1, 7).setValue(statusBaru);
        return { success: true, message: "Status pesanan berhasil diubah." };
      }
    }
    return { success: false, message: "Invoice tidak ditemukan." };
  } catch (err) { return { success: false, message: err.toString() }; }
}

